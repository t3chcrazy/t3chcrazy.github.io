---
import JobCard from "./JobCard.astro";

const JOBS = [
    {
        company: "Qlik",
        tenure: "July 2024 - Present",
        title: "Full Stack Software Engineer",
        highlight: "Building Minihomes and the Discovery Agent insight feed, while migrating REST services to Qlik's internal best practices and hardening the delivery pipeline",
        skills: ["Go", "React", "REST APIs", "CI/CD", "AI Agents", "AI SDLC", "MCP"],
        bg: "var(--color-blue)",
        points: [
            "Built Minihomes, a new way to logically organize resources for performing specific tasks, increasing user productivity",
            "Built the Discovery Agent insight feed that visualizes changes in customer data and shipped an embed feature so users can surface it inside their own dashboards",
            "Led a major migration of REST services to Qlik's internal best practices, unblocking deployment of the embed feature",
            "Handled legacy code upgrades and KMS key migration, and implemented CI pipeline fixes that decreased release time by 30%"
        ]
    },
    {
        company: "Hwayz",
        tenure: "Oct 2023 - June 2024",
        title: "Senior Software Developer",
        highlight: "Spearheaded consumer facing apps in React Native and internal dashboards in React, driving revenue growth and consumer retention",
        skills: ["React Native", "React", "Firebase", "Reanimated"],
        bg: "var(--color-yellow)",
        points: [
            "Spearheaded development of multiple consumer facing apps in React Native and internal dashboards in React",
            "Developed a restaurant order-taking (KOT) system for rapid, efficient in-store ordering, plus a kitchen display system (KDS) for order status management",
            "Implemented native modules for the customer app including OTP auto-read, and integrated Firebase, Google Maps SDK, and Juspay's Hyper SDK for payments"
        ]
    },
    {
        company: "ShopSe",
        tenure: "Oct 2020 - Sept 2023",
        title: "Senior Software Developer",
        highlight: "Built NTB mobile lending flows in React Native for banks and NBFCs including IIFL, Kotak, HDFC, ICICI, and DMI, contributing nearly 30% of total revenue within a year",
        skills: ["React Native", "React", "SSO", "Jenkins"],
        bg: "var(--color-pink)",
        points: [
            "Built NTB mobile flows in React Native for banks and NBFCs, contributing nearly 30% of total revenue within a year",
            "Implemented an admin dashboard with SSO that unified authentication across internal sites and enabled user onboarding onto the platform",
            "Led a consumer-app design revamp in React Native and a React rework of the checkout flow, driving user growth and higher daily volume",
            "Automated web and mobile builds via Jenkins, enabling QA to generate builds and run testing efficiently"
        ]
    },
    {
        company: "Sabertooth Technologies",
        tenure: "Apr 2020 - Oct 2020",
        title: "Junior Web Developer",
        highlight: "Solely created multiple React Native prototype projects for demonstration purposes",
        skills: ["React Native", "Flutter", "Bootstrap"],
        bg: "var(--color-lime)",
        points: [
            "Solely built multiple React Native prototype apps for client demonstrations",
            "Explored Flutter as an alternative cross platform stack for early stage prototypes",
            "Delivered Bootstrap based web prototypes on short client turnaround times"
        ]
    },
    {
        company: "ProSavinns",
        tenure: "Oct 2019 - Mar 2020",
        title: "Web Developer",
        highlight: "Built the initial React Native app and integrated Google Maps to show a list of associated merchants",
        skills: ["React Native", "Flask", "Google APIs"],
        bg: "var(--color-green)",
        points: [
            "Built the company's first React Native app from the ground up",
            "Integrated Google Maps APIs to surface associated merchants near the user",
            "Developed Flask services powering the app's merchant data endpoints"
        ]
    }
]
---
<section id = "workSection">
    <div class = "workIntro">
        <h2 class = "display3">Experience</h2>
        <p class = "bodyLg">
            A track record of shipping <strong>products</strong>, <strong>platforms</strong>, and <strong>flows</strong> that real users depend on every day, across a range of industries and teams.
        </p>
    </div>
    <ol class = "timeline">
        {JOBS.map((job, index) => <JobCard job = {job} index = {index} />)}
    </ol>
    <div class = "workCta">
        <p class = "bodyLg">Want the full story?</p>
        <a class = "ctaPrimary" href = "/resume.pdf" target="_blank" rel="noopener">Resume (PDF)</a>
    </div>
</section>
<script>
    const items = Array.from(document.querySelectorAll("#workSection .timelineItem"))
    const observer = new IntersectionObserver((entries, obs) => {
        entries.forEach(entry => {
            if (entry.isIntersecting) {
                entry.target.classList.add("itemRevealed")
                obs.unobserve(entry.target)
            }
        })
    }, { threshold: 0.15 })
    items.forEach(item => observer.observe(item))
</script>
<style>
    #workSection {
        display: flex;
        flex-direction: column;
        gap: 60px;
    }
    .workIntro {
        max-width: 720px;
        display: flex;
        flex-direction: column;
        gap: 16px;
    }
    .workIntro p {
        color: var(--secondary);
    }
    .workIntro strong {
        color: var(--primary);
    }
    .timeline {
        position: relative;
        list-style: none;
        display: flex;
        flex-direction: column;
        padding: 0;
        margin: 0;
        max-width: 820px;
    }
    .timeline::before {
        content: "";
        position: absolute;
        top: 12px;
        bottom: 12px;
        left: 13px;
        width: 2px;
        background-color: var(--border-color);
    }
    .workCta {
        display: flex;
        align-items: center;
        justify-content: center;
        flex-direction: column;
        gap: 20px;
        padding-top: 20px;
    }
    .workCta p {
        color: var(--secondary);
    }
    .ctaPrimary {
        display: inline-flex;
        align-items: center;
        padding: 0.85rem 1.7rem;
        border-radius: 999px;
        text-decoration: none;
        font-weight: 600;
        background-color: var(--cta-bg);
        color: var(--cta-text);
        box-shadow: var(--shadow-sm);
        transition: transform var(--duration-fast) var(--spring), box-shadow var(--duration-fast) var(--ease), background-color var(--duration-fast) var(--ease);
    }
    .ctaPrimary:hover, .ctaPrimary:focus-visible {
        background-color: var(--cta-bg-hover);
        transform: translateY(-3px);
        box-shadow: var(--shadow-md);
    }
    @media only screen and (max-width: 576px) {
        .timeline::before {
            left: 9px;
        }
    }
</style>
