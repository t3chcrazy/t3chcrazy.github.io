---
export interface Props {
    job: {
        company: string;
        tenure: string;
        title: string;
        highlight: string;
        skills: string[];
        bg: string;
        points: string[];
    };
    index: number;
}
const { job: { company, tenure, title, highlight, skills, bg, points }, index } = Astro.props
---
<li class = "timelineItem" style = {`--item-accent:${bg}; --reveal-delay:${Math.min(index, 5) * 90}ms`}>
    <div class = "itemRail" aria-hidden = "true">
        <span class = "itemDot"></span>
    </div>
    <div class = "itemContent">
        <span class = "itemTenure">{tenure}</span>
        <div class = "itemHead">
            <h3>{title}</h3>
            <span class = "itemCompany">{company}</span>
        </div>
        <p class = "itemHighlight">{highlight}</p>
        <ul class = "itemPoints">
            {points.map((point: string) => <li>{point}</li>)}
        </ul>
        <ul class = "itemSkills">
            {skills.map((skill: string) => <li>{skill}</li>)}
        </ul>
    </div>
</li>
<style>
    .timelineItem {
        position: relative;
        display: grid;
        grid-template-columns: 28px 1fr;
        column-gap: 28px;
        padding-bottom: 48px;
        transition: opacity var(--duration-slow) var(--spring), transform var(--duration-slow) var(--spring);
        transition-delay: var(--reveal-delay, 0ms);
    }
    .timelineItem:last-child {
        padding-bottom: 0;
    }
    :global(html.js) .timelineItem:not(.itemRevealed) {
        opacity: 0;
        transform: translateY(20px);
    }
    .timelineItem.itemRevealed {
        opacity: 1;
        transform: translateY(0);
    }
    .itemRail {
        display: flex;
        justify-content: center;
        padding-top: 6px;
    }
    .itemDot {
        width: 14px;
        height: 14px;
        border-radius: 50%;
        background-color: var(--bg-elevated);
        border: 3px solid var(--item-accent);
        box-shadow: 0 0 0 4px var(--bg);
        transition: transform var(--duration-fast) var(--spring), background-color var(--duration-fast) var(--ease);
    }
    .timelineItem:hover .itemDot {
        background-color: var(--item-accent);
        transform: scale(1.15);
    }
    .itemContent {
        display: flex;
        flex-direction: column;
        gap: 10px;
        padding-top: 2px;
    }
    .itemTenure {
        color: var(--secondary);
        font-size: 0.85rem;
    }
    .itemHead {
        display: flex;
        align-items: baseline;
        gap: 10px;
        flex-wrap: wrap;
    }
    .itemHead h3 {
        color: var(--primary);
        font-size: 1.35rem;
    }
    .itemCompany {
        color: var(--secondary);
        font-weight: 600;
    }
    .itemHighlight {
        color: var(--secondary);
        line-height: 1.55;
        margin: 0;
        max-width: 68ch;
    }
    .itemPoints {
        list-style: none;
        display: flex;
        flex-direction: column;
        gap: 8px;
        padding: 0;
        margin: 4px 0 0;
    }
    .itemPoints > li {
        position: relative;
        padding-left: 20px;
        color: var(--secondary);
        line-height: 1.5;
        font-size: 0.92rem;
    }
    .itemPoints > li::before {
        content: "";
        position: absolute;
        left: 0;
        top: 0.5em;
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background-color: var(--item-accent);
    }
    .itemSkills {
        list-style: none;
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        padding: 0;
        margin-top: 6px;
    }
    .itemSkills > li {
        padding: 5px 12px;
        border-radius: 999px;
        background-color: var(--item-accent);
        color: var(--color-dark);
        font-size: 0.82rem;
        font-weight: 500;
    }
    @media only screen and (max-width: 576px) {
        .timelineItem {
            grid-template-columns: 20px 1fr;
            column-gap: 18px;
            padding-bottom: 36px;
        }
        .itemDot {
            width: 12px;
            height: 12px;
        }
        .itemHead h3 {
            font-size: 1.15rem;
        }
    }
    @media (prefers-reduced-motion: reduce) {
        :global(html.js) .timelineItem:not(.itemRevealed) {
            opacity: 1;
            transform: none;
        }
    }
</style>
