---
import Svg from '@jasikpark/astro-svg-loader'

const LINKS = [
    { href: "/#workSection", label: "Experience", id: "workSection" },
    { href: "/#overviewSection", label: "Overview", id: "overviewSection" },
    { href: "/#aboutSection", label: "About", id: "aboutSection" },
    { href: "/#contactSection", label: "Contact", id: "contactSection" },
]
---
<nav id = "navbar" aria-label = "Primary">
    <div class = "navInner">
        <p class = "brandMark">
            <a href = "/#heroSection" title = "Abhishek Prashant, home">AP</a>
        </p>
        <ul id = "nav-buttons">
            {LINKS.map(link => (
                <li><a class = "underlineLink" data-section = {link.id} data-label = {link.label} href = {link.href}>{link.label}</a></li>
            ))}
            <li><a class = "underlineLink" data-label = "Resume" href = "/resume.pdf" target="_blank" rel="noopener" data-goatcounter-click = "resume-click">Resume</a></li>
            <li><a class = "underlineLink" data-label = "Blog" href = "/blog" target="_blank" rel="noopener" aria-label = "Blog (opens in new tab)" data-goatcounter-click = "blog-click">Blog<svg class = "externalIcon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17 17 7M8 7h9v9"></path></svg></a></li>
        </ul>
        <div class = "navControls">
            <button id = "themeToggle" type="button" aria-label = "Switch to light theme">
                <svg class = "icon sunIcon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
                    <circle cx="12" cy="12" r="4"></circle>
                    <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"></path>
                </svg>
                <svg class = "icon moonIcon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                    <path d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 1020.354 15.354z"></path>
                </svg>
            </button>
            <button id = "menu" type="button" aria-label = "Toggle navigation menu" aria-expanded = "false" aria-controls = "nav-buttons">
                <Svg
                    src = {import("../images/hamburger-menu.svg?raw")}
                    aria-hidden = "true"
                />
            </button>
        </div>
    </div>
</nav>
<script>
    const navbar = document.getElementById("navbar") as HTMLElement
    const menu = document.getElementById("menu") as HTMLButtonElement
    const navList = document.getElementById("nav-buttons") as HTMLElement
    const themeToggle = document.getElementById("themeToggle") as HTMLButtonElement
    const mobileQuery = window.matchMedia("(max-width: 768px)")

    let lastPosition = 0
    let ticking = false
    document.addEventListener("scroll", () => {
        if (!ticking) {
            requestAnimationFrame(() => {
                if (window.innerWidth >= 768) {
                    if (window.scrollY - lastPosition > 0 && window.scrollY > 50) {
                        navbar.classList.add("hidden")
                    } else {
                        navbar.classList.remove("hidden")
                    }
                } else {
                    navbar.classList.remove("hidden")
                }
                lastPosition = window.scrollY
                ticking = false
            })
            ticking = true
        }
    })

    function setMenuOpen(open: boolean) {
        navList.classList.toggle("revealed", open)
        menu.setAttribute("aria-expanded", String(open))
        if (mobileQuery.matches) {
            navList.toggleAttribute("inert", !open)
        }
        if (open) {
            (navList.querySelector("a") as HTMLElement | null)?.focus()
        }
    }

    function syncInertForViewport() {
        if (mobileQuery.matches) {
            navList.toggleAttribute("inert", !navList.classList.contains("revealed"))
        } else {
            navList.removeAttribute("inert")
        }
    }
    syncInertForViewport()
    mobileQuery.addEventListener("change", syncInertForViewport)

    menu.addEventListener("click", () => {
        setMenuOpen(!navList.classList.contains("revealed"))
    })

    document.addEventListener("keydown", (e) => {
        if (e.key === "Escape" && navList.classList.contains("revealed")) {
            setMenuOpen(false)
            menu.focus()
        }
    })

    document.addEventListener("click", (e) => {
        if (!mobileQuery.matches) return
        if (!navList.classList.contains("revealed")) return
        const target = e.target as Node
        if (!navbar.contains(target)) return
        if (navList.contains(target) || menu.contains(target)) return
        setMenuOpen(false)
    })

    navList.addEventListener("click", (e) => {
        if ((e.target as HTMLElement).tagName === "A" && mobileQuery.matches) {
            setMenuOpen(false)
        }
    })

    // Theme toggle
    function applyTheme(theme: string) {
        document.documentElement.setAttribute("data-theme", theme)
        localStorage.setItem("theme", theme)
        themeToggle.setAttribute("aria-label", theme === "dark" ? "Switch to light theme" : "Switch to dark theme")
    }
    themeToggle.setAttribute(
        "aria-label",
        document.documentElement.getAttribute("data-theme") === "dark" ? "Switch to light theme" : "Switch to dark theme"
    )
    themeToggle.addEventListener("click", () => {
        const current = document.documentElement.getAttribute("data-theme")
        applyTheme(current === "dark" ? "light" : "dark")
    })

    // Active section highlighting
    const sections = LinksToSections()
    function LinksToSections() {
        const links = Array.from(navList.querySelectorAll("a[data-section]")) as HTMLAnchorElement[]
        return links.map(link => ({
            link,
            section: document.getElementById(link.dataset.section as string)
        })).filter(entry => entry.section)
    }
    const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
            const match = sections.find(s => s.section === entry.target)
            if (!match) return
            if (entry.isIntersecting) {
                sections.forEach(s => s.link.classList.remove("active"))
                match.link.classList.add("active")
            }
        })
    }, { rootMargin: "-40% 0px -50% 0px" })
    sections.forEach(s => s.section && observer.observe(s.section))
</script>
<style>
    :root {
        --menu-size: 40px;
    }
    .brandMark {
        margin: 0;
    }
    .brandMark > a {
        text-decoration-style: none;
        color: var(--primary);
        text-decoration-line: none;
        font-weight: 600;
        letter-spacing: -0.02em;
    }
    #navbar {
        z-index: 100;
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        padding-top: 40px;
        transition: transform var(--duration-base) var(--spring);
    }
    #navbar.hidden {
        transform: translateY(calc(-1 * (var(--nav-height))));
    }
    .navInner {
        display: flex;
        justify-content: space-between;
        align-items: center;
        width: min(calc(100% - 2 * var(--gutter)), 1200px);
        height: 76px;
        margin: 0 auto;
        padding: 0 30px;
        box-sizing: border-box;
        background-color: var(--bg-elevated);
        border: 1px solid var(--border-color);
        border-radius: var(--radius-md);
        box-shadow: var(--shadow-sm);
    }
    .navControls {
        display: flex;
        align-items: center;
        gap: 12px;
    }
    #themeToggle {
        display: grid;
        place-items: center;
        width: 40px;
        height: 40px;
        border-radius: 50%;
        border: 1px solid var(--border-color);
        background: var(--color-yellow);
        color: var(--color-dark);
        cursor: pointer;
        transition: transform var(--duration-fast) var(--spring), background-color var(--duration-fast) var(--ease);
    }
    :global(html[data-theme="dark"]) #themeToggle {
        background: var(--color-purple);
    }
    #themeToggle:hover {
        transform: translateY(-2px);
    }
    #themeToggle .icon {
        width: 18px;
        height: 18px;
    }
    #themeToggle .sunIcon {
        display: none;
    }
    :global(html[data-theme="dark"]) #themeToggle .sunIcon {
        display: block;
    }
    :global(html[data-theme="dark"]) #themeToggle .moonIcon {
        display: none;
    }
    #nav-buttons {
        display: flex;
        align-items: center;
        gap: 28px;
        padding: 0;
    }
    #nav-buttons li {
        list-style: none;
        position: relative;
    }
    #nav-buttons li a {
        display: block;
        animation: reveal 0.8s forwards;
        animation-timing-function: var(--ease);
        text-decoration: none;
        transform: translateY(-50px);
        color: var(--secondary);
        font-weight: 500;
        transition: color var(--duration-fast) var(--ease);
    }
    #nav-buttons li a .externalIcon {
        display: inline-block;
        width: 0.8em;
        height: 0.8em;
        margin-left: 0.25em;
        vertical-align: baseline;
    }
    #nav-buttons li a::before {
        content: attr(data-label);
        display: block;
        height: 0;
        overflow: hidden;
        font-weight: 600;
        visibility: hidden;
    }
    #nav-buttons li a.active,
    #nav-buttons li a:hover {
        color: var(--primary);
        font-weight: 600;
    }
    #nav-buttons li:nth-child(2) > a {
        animation-delay: 80ms;
    }
    #nav-buttons li:nth-child(3) > a {
        animation-delay: 160ms;
    }
    #nav-buttons li:nth-child(4) > a {
        animation-delay: 240ms;
    }
    #nav-buttons li:nth-child(5) > a {
        animation-delay: 320ms;
    }
    #nav-buttons li:nth-child(6) > a {
        animation-delay: 400ms;
    }
    #menu {
        display: none;
    }
    @keyframes reveal {
        0% {
            transform: translateY(-50px);
            opacity: 0;
        }
        100% {
            transform: translateY(0px);
            opacity: 1;
        }
    }
    @media only screen and (max-width: 576px) {
        #navbar {
            padding-top: 20px;
        }
        .navInner {
            padding: 0 20px;
        }
    }
    @media only screen and (max-width: 768px) {
        #menu {
            z-index: 100;
            width: var(--menu-size);
            height: var(--menu-size);
            display: flex;
            place-items: center;
            border-radius: 50%;
            cursor: pointer;
            border: none;
            background: none;
            color: var(--primary);
        }
        #menu svg {
            width: 40px;
            height: 40px;
        }
        #nav-buttons {
            position: fixed;
            background-color: var(--bg-elevated);
            box-shadow: var(--shadow-lg);
            right: 0;
            top: 0;
            height: 100vh;
            height: 100dvh;
            width: min(70%, 300px);
            flex-flow: column;
            align-items: flex-start;
            transform: translateX(100%);
            transition: transform var(--duration-base) var(--spring);
            padding: calc(var(--menu-size) + 32px) 32px 32px !important;
            margin: 0;
            border-radius: var(--radius-lg) 0 0 var(--radius-lg);
        }
        #nav-buttons.revealed {
            transform: translateX(0)
        }
        #nav-buttons li a {
            font-size: 1.1rem;
        }
    }
</style>
