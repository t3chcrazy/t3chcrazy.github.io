---
import Svg from '@jasikpark/astro-svg-loader'

const SOCIALS = [
    {
        icon: import('../images/mail.svg?raw'),
        link: "mailto:abhishekprashant09@gmail.com",
        alt: "Email",
        bg: "var(--color-blue)",
        event: "contact-mail-click"
    },
    {
        icon: import('../images/stackoverflow.svg?raw'),
        link: "https://stackoverflow.com/users/4741470/abhishek-prashant",
        alt: "Stack Overflow",
        bg: "var(--color-pink)",
        event: "contact-stackoverflow-click"
    },
    {
        icon: import('../images/linkedin.svg?raw'),
        link: "https://www.linkedin.com/in/abhishek-prashant-app-dev/",
        alt: "LinkedIn",
        bg: "var(--color-yellow)",
        event: "contact-linkedin-click"
    },
    {
        icon: import('../images/github.svg?raw'),
        link: "https://github.com/t3chcrazy",
        alt: "GitHub",
        bg: "var(--color-lime)",
        event: "contact-github-click"
    }
]
---
<section id = "contactSection">
    <div class = "bgDot dotPurple" aria-hidden = "true"></div>
    <div class = "bgDot dotPowder" aria-hidden = "true"></div>
    <div class = "bgDot dotLime" aria-hidden = "true"></div>
    <div class = "bottomSection">
        <h2 class = "display3">Get in touch</h2>
        <p>
            Open to new opportunities and always happy to connect with like-minded people.
        </p>
        <a class = "ctaPrimary" href = "mailto:abhishekprashant09@gmail.com" data-goatcounter-click = "contact-email-cta">Email me</a>
    </div>
    <ul class = "socialsList">
        {SOCIALS.map(social => (
            <li style = {`--pill-bg:${social.bg}`}>
                <a href = {social.link} target = "_blank" rel="noopener" aria-label = {social.alt} data-goatcounter-click = {social.event}>
                    <Svg
                        src = {social.icon}
                        aria-hidden = "true"
                    />
                </a>
            </li>
        ))}
    </ul>
</section>
<style>
    #contactSection {
        display: flex;
        flex-flow: column;
        align-items: center;
        justify-content: center;
        text-align: center;
        position: relative;
        overflow: hidden;
        background-color: var(--color-green);
        border-radius: var(--radius-lg);
        padding: 80px 40px;
    }
    :global(html[data-theme="dark"]) #contactSection {
        background-color: var(--bg-inset);
    }
    .bgDot {
        position: absolute;
        border-radius: 50%;
        pointer-events: none;
        opacity: 0;
        animation: dotIn 1.1s forwards var(--spring);
    }
    .dotPurple {
        width: 56px;
        height: 56px;
        background-color: var(--color-purple);
        top: 10%;
        left: 8%;
        animation-delay: 0.9s;
    }
    .dotPowder {
        width: 40px;
        height: 40px;
        background-color: var(--color-powder);
        top: 6%;
        right: 20%;
        animation-delay: 1.05s;
    }
    .dotLime {
        width: 46px;
        height: 46px;
        background-color: var(--color-lime);
        bottom: 12%;
        right: 15%;
        animation-delay: 1.2s;
    }
    @keyframes dotIn {
        0% {
            opacity: 0;
            transform: scale(0.6);
        }
        100% {
            opacity: 1;
            transform: scale(1);
        }
    }
    ul {
        list-style: none;
        display: flex;
        align-items: center;
        padding: 0;
        column-gap: 18px;
        position: relative;
        z-index: 1;
    }
    li a {
        display: grid;
        place-items: center;
        width: 50px;
        height: 50px;
        border-radius: 50%;
        color: var(--color-dark);
        background-color: var(--pill-bg, var(--color-blue));
        transition: transform var(--duration-fast) var(--spring), box-shadow var(--duration-fast) var(--ease);
    }
    li svg {
        width: 20px;
        height: 20px;
    }
    li a:hover, li a:focus-visible {
        transform: translateY(-5px) rotate(-6deg);
        box-shadow: var(--shadow-md);
    }
    :global(html.js) .socialsList li {
        opacity: 0;
    }
    #contactSection.revealed .socialsList li {
        animation: iconIn var(--duration-base) forwards var(--spring);
    }
    .socialsList li:nth-child(1) {
        animation-delay: 0.05s;
    }
    .socialsList li:nth-child(2) {
        animation-delay: 0.15s;
    }
    .socialsList li:nth-child(3) {
        animation-delay: 0.25s;
    }
    .socialsList li:nth-child(4) {
        animation-delay: 0.35s;
    }
    @keyframes iconIn {
        0% {
            opacity: 0;
            transform: translateY(14px) scale(0.9);
        }
        100% {
            opacity: 1;
            transform: none;
        }
    }
    .bottomSection {
        display: inherit;
        flex-flow: column;
        align-items: center;
        margin-bottom: 40px;
        position: relative;
        z-index: 1;
    }
    .bottomSection > h2 {
        color: var(--primary);
    }
    .bottomSection > p {
        color: var(--secondary);
        line-height: 1.5;
        max-width: 50ch;
        text-align: center;
        margin: 1rem 0 0;
    }
    .ctaPrimary {
        display: inline-flex;
        align-items: center;
        margin-top: 1.75rem;
        padding: 0.85rem 1.7rem;
        border-radius: 999px;
        text-decoration: none;
        font-weight: 600;
        background-color: var(--cta-bg);
        color: var(--cta-text);
        box-shadow: var(--shadow-sm);
        transition: transform var(--duration-fast) var(--spring), box-shadow var(--duration-fast) var(--ease), background-color var(--duration-fast) var(--ease);
    }
    .ctaPrimary:hover, .ctaPrimary:focus-visible {
        background-color: var(--cta-bg-hover);
        transform: translateY(-3px);
        box-shadow: var(--shadow-md);
    }
    @media (prefers-reduced-motion: reduce) {
        .bgDot {
            animation: none;
            opacity: 1;
        }
        :global(html.js) .socialsList li {
            opacity: 1;
            animation: none;
        }
    }
</style>