---
const CARDS = [
    {
        id: "work",
        label: "Experience",
        title: "See my experience",
        desc: "Six years of shipping across a range of industries.",
        href: "#workSection",
        accent: "var(--color-blue)",
        fly: "left"
    },
    {
        id: "about",
        label: "About",
        title: "Get to know me",
        desc: "Who I am and how I build.",
        href: "#aboutSection",
        accent: "var(--color-yellow)",
        fly: "up"
    },
    {
        id: "contact",
        label: "Contact",
        title: "Let's get in touch",
        desc: "Open to new opportunities.",
        href: "#contactSection",
        accent: "var(--color-green)",
        fly: "right"
    }
]
---
<section id = "infoCardsSection">
    <ul class = "infoCards">
        {CARDS.map(card => (
            <li class:list = {["infoCard", `fly-${card.fly}`]} style = {`--card-accent:${card.accent}`}>
                <a href = {card.href}>
                    <span class = "cardLabel">{card.label}</span>
                    <span class = "cardTitle">{card.title}</span>
                    <span class = "cardDesc">{card.desc}</span>
                    <span class = "cardArrow" aria-hidden = "true">&rarr;</span>
                </a>
            </li>
        ))}
    </ul>
</section>
<script>
    const cards = Array.from(document.querySelectorAll("#infoCardsSection .infoCard"))
    const observer = new IntersectionObserver((entries, obs) => {
        entries.forEach(entry => {
            if (entry.isIntersecting) {
                entry.target.classList.add("settled")
                obs.unobserve(entry.target)
            }
        })
    }, { threshold: 0.3 })
    cards.forEach(card => observer.observe(card))
</script>
<style>
    #infoCardsSection {
        padding: 3rem 0;
    }
    .infoCards {
        list-style: none;
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 24px;
        padding: 0;
        margin: 0;
    }
    .infoCard {
        border-radius: var(--radius-md);
        background-color: var(--bg-elevated);
        border: 1px solid var(--border-color);
        box-shadow: var(--shadow-sm);
        transition: transform var(--duration-spring) var(--spring), opacity var(--duration-spring) var(--spring), box-shadow var(--duration-base) var(--ease);
    }
    /* Fly-in start states only when JS runs, so no-JS visitors still see the cards */
    :global(html.js) .infoCard:not(.settled) {
        opacity: 0;
    }
    :global(html.js) .infoCard.fly-left:not(.settled) {
        transform: translateX(-60px) rotate(-4deg);
    }
    :global(html.js) .infoCard.fly-right:not(.settled) {
        transform: translateX(60px) rotate(4deg);
    }
    :global(html.js) .infoCard.fly-up:not(.settled) {
        transform: translateY(40px) scale(0.96);
    }
    .infoCard:hover {
        box-shadow: var(--shadow-md);
    }
    .infoCard > a {
        display: flex;
        flex-direction: column;
        gap: 10px;
        padding: 32px 28px;
        height: 100%;
        box-sizing: border-box;
        text-decoration: none;
        color: var(--primary);
        transition: transform var(--duration-base) var(--spring);
    }
    .infoCard > a:hover {
        transform: translateY(-6px);
    }
    .cardLabel {
        font-family: var(--font-hand);
        font-size: 1.2rem;
        font-weight: 600;
        color: var(--secondary);
    }
    .cardTitle {
        font-size: 1.3rem;
        font-weight: 600;
        letter-spacing: -0.02em;
    }
    .cardDesc {
        font-size: 0.95rem;
        color: var(--secondary);
    }
    .cardArrow {
        margin-top: auto;
        display: inline-grid;
        place-items: center;
        width: 40px;
        height: 40px;
        border-radius: 50%;
        background-color: var(--card-accent);
        color: var(--color-dark);
        font-size: 1.1rem;
        transition: transform var(--duration-fast) var(--spring);
    }
    .infoCard > a:hover .cardArrow {
        transform: translateX(6px);
    }
    @media only screen and (max-width: 768px) {
        .infoCards {
            grid-template-columns: 1fr;
        }
    }
    @media (prefers-reduced-motion: reduce) {
        :global(html.js) .infoCard:not(.settled) {
            opacity: 1;
            transform: none;
        }
        .infoCard {
            transition: none;
        }
    }
</style>
