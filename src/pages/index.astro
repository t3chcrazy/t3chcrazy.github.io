---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Intro from '../components/Intro.astro';
import InfoCards from '../components/InfoCards.astro';
import Experience from '../components/Experience.astro';
import Process from '../components/Process.astro';
import AboutMe from '../components/AboutMe.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Abhishek Prashant | Full Stack Software Engineer">
	<Navbar />
	<main id="main">
		<Intro />
		<InfoCards />
		<Experience />
		<Process />
		<AboutMe />
		<Contact />
	</main>
	<Footer />
</Layout>
<script>
	const bottomSections = Array.from(document.querySelectorAll("section[id$=Section]")).slice(1)
	bottomSections.forEach(bottomSection => {
		const observer = new IntersectionObserver((entries, obs) => {
			if (entries[0].isIntersecting) {
				bottomSection.classList.add("revealed")
				obs.disconnect()
			}
		}, {
			threshold: 0.1
		})
		observer.observe(bottomSection)
	})
</script>
<style>
	main {
		margin: auto;
		max-width: 1200px;
		padding: var(--contentHorizontalSpacing);
		display: flex;
		flex-direction: column;
		gap: 120px;
	}
</style>
